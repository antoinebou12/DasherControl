# Copy to `.env` and adjust. Do not commit real secrets.

# Optional: tracing filter for structured app logs (see `init_tracing` in `src/main.rs`).
# Example: RUST_LOG=dasher_control=debug,rocket=info
# RUST_LOG=dasher_control=info,rocket=warn

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@localhost:5432/diesel
CSRF_TOKEN_KEY=01234567890123456789012345678901
ROCKET_SECRET_KEY=dHBh5Uh_cK1T7m-mzQU4zpGkZI9R-uR9OTOJI_B3uEQ=

# Optional: comma-separated host:port list for the Admin Web SSH terminal.
# When unset, only loopback / RFC1918 / unique-local targets are allowed after DNS resolution.
# Example: TERMINAL_SSH_ALLOWLIST=10.0.0.5:22,192.168.1.10:2222
# TERMINAL_SSH_ALLOWLIST=

# OAuth login (Google + GitHub). Browser origin that proxies to Rocket (see frontend/vite proxy).
# Example dev (Vite HTTPS): OAUTH_PUBLIC_APP_URL=https://localhost:9999
# Example hitting Rocket directly: OAUTH_PUBLIC_APP_URL=http://127.0.0.1:8080
OAUTH_PUBLIC_APP_URL=http://127.0.0.1:8080
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# AI assistant (POST /assistant/api/chat, JWT). Keys stay server-side only.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Optional: Cloudflare speed test download size (bytes), clamped 250KB–10MB. Used by POST /system/api/network_speed_test.
# DASHER_NETWORK_SPEED_TEST_BYTES=2000000
